## 八、构建与运行

```bash
# 构建
./build.sh
# 或: mkdir build && cd build && cmake .. && make -j$(nproc) && cd ..

# 产物
ls -la server userServer fileServer oss_consumer

# 启动顺序
consul agent -dev &                        # 1. 服务发现
sudo systemctl start rabbitmq-server       # 2. 消息队列
sudo systemctl start mysql                 # 3. 数据库
./userServer &                             # 4. 用户微服务 :8001
./fileServer &                             # 5. 文件微服务 :8002
./server &                                 # 6. HTTP 网关 :8888
./oss_consumer &                           # 7. OSS Worker（可选）

# 验证
curl http://localhost:8888/                # 应返回 index.html
curl http://localhost:8500/v1/agent/services  # 应看到注册的服务
```

